# ParkMate local / Compose defaults. Copy to .env — do not commit .env.

APP_ENV=development
APP_NAME=parkmate

# Postgres
POSTGRES_USER=parkmate
POSTGRES_PASSWORD=parkmate
POSTGRES_DB=parkmate
DATABASE_URL=postgresql://parkmate:parkmate@postgres:5432/parkmate

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# API + ML worker
BACKEND_URL=http://backend:8000
