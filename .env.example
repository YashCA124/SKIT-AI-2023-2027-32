# ParkMate local / Compose settings. Copy to .env and generate the two secrets.

APP_ENV=development
APP_NAME=parkmate

# `make init-env` creates .env and fills these secrets with random values.
POSTGRES_USER=parkmate
POSTGRES_PASSWORD=
POSTGRES_DB=parkmate
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
JWT_SECRET_KEY=

# Leave empty when using the same-origin Nginx gateway; otherwise set the API origin.
VITE_API_BASE_URL=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# API + ML worker
BACKEND_URL=http://backend:8000
